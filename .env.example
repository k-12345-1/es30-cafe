# Stripe secret key. Test keys start with sk_test_, live keys with sk_live_
STRIPE_SECRET_KEY=sk_test_replace_me

# Where the site is served from. Used to build Stripe return URLs.
PUBLIC_URL=http://localhost:4242

# Port for the local server
PORT=4242

# Currency for all menu prices
CURRENCY=usd

# Staff code for the stock page. With this unset, stock can only be changed
# from the machine the server runs on.
ADMIN_TOKEN=
